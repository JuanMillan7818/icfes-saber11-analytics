# ── Modo de almacenamiento ────────────────────────────────────────────────────
STORAGE_BACKEND=local

# ── ETL ───────────────────────────────────────────────────────────────────────
DATA_PATH_TEXT=../Bases nacionales 2015-2026
PARQUET_PATH=files/parquet

# ── Supabase Storage (Fase 2) ─────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=
SUPABASE_BUCKET=icfes-parquet
SUPABASE_S3_ENDPOINT=<project-ref>.supabase.co/storage/v1/s3
SUPABASE_ACCESS_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PARQUET_PATH=s3://icfes-parquet/parquet

# ── AWS S3 (alternativa a Supabase) ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PARQUET_PATH=s3://my-bucket/icfes/parquet

# ── API FastAPI (Fase 2) ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
